(
    schema_version: 1,
    layers: [
        (
            name: "foundation",
            crates: [
                "aequora-blob",
                "aequora-compute",
                "aequora-coordination",
                "aequora-invariants",
                "aequora-ipc-protocol",
                "aequora-macros",
                "aequora-registry-types",
                "aequora-scheduler",
                "aequora-schema",
                "aequora-storage-core",
                "aequora-types",
                "aequora-update",
            ],
        ),
        (
            name: "protocol-contracts",
            crates: [
                "aequora-admin",
                "aequora-audit",
                "aequora-authority",
                "aequora-clock",
                "aequora-codec",
                "aequora-compat",
                "aequora-conformance",
                "aequora-governance",
                "aequora-integrity",
                "aequora-legacy",
                "aequora-observability",
                "aequora-operation",
                "aequora-protocol",
                "aequora-region",
                "aequora-registry-codegen",
                "aequora-registry-generated",
                "aequora-routing",
                "aequora-scope",
                "aequora-security",
                "aequora-storage-backup",
                "aequora-storage-conformance",
                "aequora-storage-encryption",
                "aequora-storage-maintenance",
                "aequora-storage-profile",
                "aequora-transport",
            ],
        ),
        (
            name: "domain-execution",
            crates: [
                "aequora-conflict",
                "aequora-crypto",
                "aequora-diagnostics",
                "aequora-executor",
                "aequora-feed",
                "aequora-jobs",
                "aequora-journal",
                "aequora-mapping",
                "aequora-metadata",
                "aequora-migration",
                "aequora-partition",
                "aequora-performance",
                "aequora-queue",
                "aequora-replay",
                "aequora-side-effects",
                "aequora-validator",
                "aequora-workflow",
            ],
        ),
        (
            name: "storage-contracts",
            crates: [
                "aequora-adapter-sdk",
                "aequora-blob-store",
                "aequora-profile",
                "aequora-store",
            ],
        ),
        (
            name: "sync-engines",
            crates: [
                "aequora-admission",
                "aequora-bootstrap",
                "aequora-client",
                "aequora-crdt",
                "aequora-live",
                "aequora-server",
            ],
        ),
        (
            name: "physical-adapters",
            crates: [
                "aequora-store-postgres",
                "aequora-store-stoolap",
            ],
        ),
        (
            name: "integration-platform",
            crates: [
                "aequora-agent",
                "aequora-axum",
                "aequora-config",
                "aequora-desktop-runtime",
                "aequora-http",
                "aequora-legacy-api",
                "aequora-mobile-bindings",
                "aequora-mobile-runtime",
                "aequora-platform-android",
                "aequora-platform-ios",
                "aequora-platform-linux",
                "aequora-platform-macos",
                "aequora-platform-windows",
                "aequora-quic",
            ],
        ),
        (
            name: "applications",
            crates: [
                "aequora",
                "aequora-cli",
                "aequora-registry-cli",
            ],
        ),
        (
            name: "tooling-verification",
            crates: [
                "aequora-dev",
                "aequora-model",
                "aequora-testkit",
            ],
        ),
    ],
    allowed_outward_edges: [
        (source: "aequora", dependency: "aequora-testkit"),
        (source: "aequora-cli", dependency: "aequora-model"),
    ],
    dependency_budgets: [
        (crate_name: "aequora-types", max_workspace: 0, max_external: 3),
        (crate_name: "aequora-protocol", max_workspace: 1, max_external: 2),
        (crate_name: "aequora-storage-core", max_workspace: 0, max_external: 2),
        (crate_name: "aequora-client", max_workspace: 18, max_external: 3),
        (crate_name: "aequora-server", max_workspace: 26, max_external: 4),
        (crate_name: "aequora-axum", max_workspace: 10, max_external: 6),
    ],
    exclusive_dependencies: [
        (dependency: "sqlx", owners: ["aequora-store-postgres"]),
        (dependency: "stoolap", owners: ["aequora-store-stoolap"]),
        (dependency: "quinn", owners: ["aequora-quic"]),
        (dependency: "reqwest", owners: ["aequora", "aequora-http"]),
        (dependency: "axum", owners: ["aequora", "aequora-axum", "aequora-http"]),
        (dependency: "tower", owners: ["aequora-axum"]),
        (dependency: "jni", owners: ["aequora-platform-android"]),
        (dependency: "windows-sys", owners: ["aequora-platform-windows"]),
        (dependency: "objc2", owners: ["aequora-platform-ios", "aequora-platform-macos"]),
        (dependency: "security-framework", owners: ["aequora-platform-ios", "aequora-platform-macos"]),
    ],
)
