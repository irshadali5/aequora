(
    schema_version: 1,
    level: Standard,
    protocol: (
        max_frame_bytes: 4194304,
        max_operations_per_batch: 1000,
        max_collection_items: 10000,
        max_nesting_depth: 64,
        max_dependency_edges: 5000,
        max_string_bytes: 262144,
        max_compressed_bytes: 4194304,
        max_decompressed_bytes: 67108864,
        max_compression_ratio: 64,
    ),
    auth: (
        trusted_issuers: ["https://identity.example.invalid"],
        required_audience: "aequora-sync",
        require_device_binding: true,
        minimum_assurance: Normal,
        max_authentication_age_ms: 86400000,
    ),
    egress: (
        allow_plain_http: false,
        block_private_networks: true,
        max_redirects: 0,
        max_url_bytes: 2048,
    ),
    uploads: (
        max_blob_bytes: 104857600,
        max_chunks: 10000,
        max_archive_entries: 10000,
        max_archive_expanded_bytes: 536870912,
        max_archive_ratio: 64,
        max_path_bytes: 512,
    ),
    browser_controls: [
        SecureCookie,
        HttpOnlyCookie,
        SameSiteCookie,
        CsrfProtection,
        Hsts,
        ContentSecurityPolicy,
        NoSniff,
    ],
    deployment_controls: [
        PrivateAdminListener,
        MfaForDestructiveAdmin,
    ],
)
