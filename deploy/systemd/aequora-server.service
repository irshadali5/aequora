[Unit]
Description=Aequora synchronization server
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=aequora
Group=aequora
ExecStart=/usr/bin/aequora-server --config /etc/aequora/server.ron
EnvironmentFile=-/etc/aequora/secrets.env
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/aequora /var/log/aequora
TimeoutStopSec=45s

[Install]
WantedBy=multi-user.target

